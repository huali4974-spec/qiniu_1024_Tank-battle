var (
	ticks = 0
	beforeX = 0.0
	beforeY = 0.0
	spawnBand = 0
	spawnX = 0.0
	spawnY = 0.0
	turnChoice = 0
	hit = false
)

onStart => {
	hide
	for running {
		if spawned < 20 && activeEnemies < 4 {
			spawnBand = int(rand(0, 4))
			if spawnBand == 3 {
				spawnX = float64((int(rand(0, 3)) - 1) * 48)
				spawnY = 0
			} else {
				spawnX = float64(int(rand(0, 7)) * 48 - 144)
				if spawnBand == 0 {
					spawnY = 144
				} else if spawnBand == 1 {
					spawnY = 120
				} else {
					spawnY = 48
				}
			}
			setXYpos spawnX, spawnY
			if !touching("Enemy") {
				clone
				spawned++
				activeEnemies++
			}
		}
		wait 4
	}
}

onCloned data => {
	ticks = 0
	hit = false
	setHeading Down
	setCostume "down"
	show
	for running {
		beforeX = xpos
		beforeY = ypos
		step 24
		if xpos < -144 || xpos > 144 || ypos < -144 || ypos > 144 || touching("Brick") || touching("Steel") || touching("Eagle") {
			setXYpos beforeX, beforeY
			turnChoice = int(rand(0, 4))
			if turnChoice == 0 {
				setHeading Left
				setCostume "left"
			} else if turnChoice == 1 {
				setHeading Right
				setCostume "right"
			} else if turnChoice == 2 {
				setHeading Down
				setCostume "down"
			} else {
				setHeading Up
				setCostume "up"
			}
		}
		if ticks > 0 && ticks % 2 == 0 {
			if heading == 0 {
				EnemyShot.setXYpos xpos-3, ypos+13
			} else if heading == 90 {
				EnemyShot.setXYpos xpos+13, ypos+3
			} else if heading == 180 {
				EnemyShot.setXYpos xpos-3, ypos-13
			} else {
				EnemyShot.setXYpos xpos-13, ypos+3
			}
			EnemyShot.setHeading heading
			EnemyShot.clone
		}
		ticks++
		wait 0.65
	}
	destroy
}

onTouchStart "PlayerShot", sprite => {
	if hit || !running {
		return
	}
	hit = true
	score += 100
	defeated++
	activeEnemies--
	Burst.setXYpos xpos, ypos
	Burst.clone
	if defeated >= 20 {
		running = false
		broadcast "win"
	}
	destroy
}
