onCloned data => {
	ticks = 0
	hit = false
	setHeading Down
	setCostume "down"
	show
	for running {
		beforeX = xpos
		beforeY = ypos
		step 0.7
		if xpos < -144 || xpos > 144 || ypos < -144 || ypos > 144 || touching("Brick") || touching("Steel") || touching("River") || touching("Eagle") {
			setXYpos beforeX, beforeY
			if ticks % 8 == 0 {
				turnChoice = int(rand(0, 4))
				if turnChoice == 0 {
					setHeading Left
					setCostume "left"
				} else if turnChoice == 1 {
					setHeading Right
					setCostume "right"
				} else if turnChoice == 2 {
					setHeading Down
					setCostume "down"
				} else {
					setHeading Up
					setCostume "up"
				}
			}
		}
		if ticks > 0 && ticks % 65 == 0 {
			EnemyShot.setXYpos xpos, ypos
			EnemyShot.setHeading heading
			EnemyShot.clone
		}
		ticks++
		wait 0.02
	}
	destroy
}

onTouchStart "PlayerShot", sprite => {
	if hit || !running {
		return
	}
	hit = true
	score += 100
	defeated++
	activeEnemies--
	Burst.setXYpos xpos, ypos
	Burst.clone
	if defeated >= 20 {
		running = false
		broadcast "win"
	}
	destroy
}
