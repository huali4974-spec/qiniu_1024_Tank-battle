var (
	ticks = 0
	beforeX = 0.0
	beforeY = 0.0
)

onStart => {
	hide
	for running {
		if spawned < 20 && activeEnemies < 4 {
			if spawned % 3 == 0 {
				setXYpos -144, 144
			} else if spawned % 3 == 1 {
				setXYpos 0, 144
			} else {
				setXYpos 144, 144
			}
			clone
			spawned++
			activeEnemies++
		}
		wait 1.8
	}
}

onCloned data => {
	ticks = 0
	setHeading Down
	setCostume "down"
	show
	for running {
		beforeX = xpos
		beforeY = ypos
		step 1.3
		if xpos < -144 || xpos > 144 || ypos < -144 || ypos > 144 || touching(Brick) || touching(Steel) || touching(Eagle) {
			setXYpos beforeX, beforeY
			if ticks % 4 == 0 {
				setHeading Left
				setCostume "left"
			} else if ticks % 4 == 1 {
				setHeading Right
				setCostume "right"
			} else if ticks % 4 == 2 {
				setHeading Down
				setCostume "down"
			} else {
				setHeading Up
				setCostume "up"
			}
		}
		if ticks > 0 && ticks % 65 == 0 {
			EnemyShot.setXYpos xpos, ypos
			EnemyShot.setHeading heading
			EnemyShot.clone
		}
		ticks++
		wait 0.02
	}
	destroy
}

onTouchStart "PlayerShot", sprite => {
	if !running {
		return
	}
	score += 100
	defeated++
	activeEnemies--
	Burst.setXYpos xpos, ypos
	Burst.clone
	if defeated >= 20 {
		running = false
		broadcast "win"
	}
	destroy
}
