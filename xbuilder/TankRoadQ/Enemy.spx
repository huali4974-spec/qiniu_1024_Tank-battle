var (
	ticks = 0
	beforeX = 0.0
	beforeY = 0.0
	spawnChoice = 0
	spawnSection = 0
	spawnMap = 1
	spawnOffset = 0.0
	spawnX = 0.0
	spawnY = 0.0
	turnChoice = 0
	hit = false
	enemyTier = 0
	enemyHP = 1
)

func updateEnemyCostume() {
	if enemyTier == 2 {
		if heading == 0 {
			setCostume "gold_up"
		} else if heading == 90 {
			setCostume "gold_right"
		} else if heading == 180 {
			setCostume "gold_down"
		} else {
			setCostume "gold_left"
		}
	} else if enemyTier == 1 {
		if heading == 0 {
			setCostume "platinum_up"
		} else if heading == 90 {
			setCostume "platinum_right"
		} else if heading == 180 {
			setCostume "platinum_down"
		} else {
			setCostume "platinum_left"
		}
	} else if heading == 0 {
		setCostume "up"
	} else if heading == 90 {
		setCostume "right"
	} else if heading == 180 {
		setCostume "down"
	} else {
		setCostume "left"
	}
}

func defeatEnemy() {
	if enemyTier == 2 {
		score += 500
	} else if enemyTier == 1 {
		score += 300
	} else {
		score += 100
	}
	defeated++
	activeEnemies--
	play "EnemyDown"
	Burst.setXYpos xpos, ypos
	Burst.clone
	if defeated == 4 || defeated == 11 || defeated == 18 || defeated == 25 {
		broadcastAndWait "clearPowerUp"
		PowerUp.setXYpos xpos, ypos
		if roundNumber >= 2 && defeated == 4 {
			PowerUp.setCostume "shovel"
		} else {
			turnChoice = int(rand(0, 5))
			if turnChoice == 0 {
				PowerUp.setCostume "tank"
			} else if turnChoice == 1 {
				PowerUp.setCostume "star"
			} else if turnChoice == 2 {
				PowerUp.setCostume "grenade"
			} else if turnChoice == 3 {
				PowerUp.setCostume "timer"
			} else if turnChoice == 4 {
				PowerUp.setCostume "helmet"
			} else {
				PowerUp.setCostume "shovel"
			}
		}
		play "PickupAppear"
		PowerUp.clone
	}
	destroy
}

