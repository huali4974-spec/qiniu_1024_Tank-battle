var (
	ticks = 0
	beforeX = 0.0
	beforeY = 0.0
	lane = 0
	lastLane = -1
	turnChoice = 0
)

onStart => {
	hide
	lastLane = -1
	for running {
		if spawned < 20 && activeEnemies < 4 {
			lane = int(rand(0, 3))
			if lane == lastLane {
				lane = (lane + 1 + int(rand(0, 2))) % 3
			}
			lastLane = lane
			if lane == 0 {
				setXYpos -144, 144
			} else if lane == 1 {
				setXYpos 0, 144
			} else {
				setXYpos 144, 144
			}
			clone
			spawned++
			activeEnemies++
		}
		wait 1.8
	}
}

onCloned data => {
	ticks = 0
	setHeading Down
	setCostume "down"
	show
	for running {
		beforeX = xpos
		beforeY = ypos
		step 0.7
		if xpos < -144 || xpos > 144 || ypos < -144 || ypos > 144 || touching("Brick") || touching("Steel") || touching("Eagle") {
			setXYpos beforeX, beforeY
			if ticks % 8 == 0 {
				turnChoice = int(rand(0, 4))
				if turnChoice == 0 {
					setHeading Left
					setCostume "left"
				} else if turnChoice == 1 {
					setHeading Right
					setCostume "right"
				} else if turnChoice == 2 {
					setHeading Down
					setCostume "down"
				} else {
					setHeading Up
					setCostume "up"
				}
			}
		}
		if ticks > 0 && ticks % 65 == 0 {
			EnemyShot.setXYpos xpos, ypos
			EnemyShot.setHeading heading
			EnemyShot.clone
		}
		ticks++
		wait 0.02
	}
	destroy
}

onTouchStart "PlayerShot", sprite => {
	if !running {
		return
	}
	score += 100
	defeated++
	activeEnemies--
	Burst.setXYpos xpos, ypos
	Burst.clone
	if defeated >= 20 {
		running = false
		broadcast "win"
	}
	destroy
}
