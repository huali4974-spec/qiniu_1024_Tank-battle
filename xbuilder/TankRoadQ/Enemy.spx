onCloned data => {
	spawned++
	activeEnemies++
	ticks = 0
	hit = false
	setHeading Down
	updateEnemyCostume()
	show
	for running {
		if !gameReady || timer < enemyFreezeUntil {
			wait 0.02
			continue
		}
		if ticks > 0 && ticks % 100 == 0 {
			if ypos < -360 && xpos > 12 {
				setHeading Left
			} else if ypos < -360 && xpos < -12 {
				setHeading Right
			} else {
				setHeading Down
			}
			updateEnemyCostume()
		}
		beforeX = xpos
		beforeY = ypos
		step 0.7
		if xpos < -144 || xpos > 144 || ypos < -456 || ypos > 456 || touching("Brick") || touching("Steel") || touching("River") || touching("Eagle") {
			setXYpos beforeX, beforeY
			if ticks % 8 == 0 {
				turnChoice = int(rand(0, 4))
				if turnChoice == 0 {
					setHeading Left
				} else if turnChoice == 1 {
					setHeading Right
				} else if turnChoice == 2 || turnChoice == 3 {
					setHeading Down
				} else {
					setHeading Up
				}
				updateEnemyCostume()
			}
		}
		if ticks > 0 && ticks % 90 == 0 {
			EnemyShot.setXYpos xpos, ypos
			EnemyShot.setHeading heading
			EnemyShot.clone
		}
		ticks++
		if ticks >= 3000 {
			spawned--
			activeEnemies--
			destroy
		}
		wait 0.02
	}
	destroy
}

onTouchStart "PlayerShot", sprite => {
	if hit || !running || !gameReady {
		return
	}
	enemyHP--
	if enemyHP > 0 {
		play "ArmorHit"
		Burst.setXYpos xpos, ypos
		Burst.clone
		return
	}
	hit = true
	defeatEnemy()
}

onMsg "grenade", => {
	if visible && !hit && running && gameReady {
		hit = true
		defeatEnemy()
	}
}
