var (
	lastShot = -1.0
	invulnerable = false
	beforeX = 0.0
	beforeY = 0.0
)

func syncCamera() {
	if ypos < -324 {
		Camera.setXYpos 0, -324
	} else if ypos > 324 {
		Camera.setXYpos 0, 324
	} else {
		Camera.setXYpos 0, ypos
	}
}

func takeHit() {
	if invulnerable || timer < playerShieldUntil || !running || !gameReady {
		return
	}
	lives--
	Burst.setXYpos xpos, ypos
	Burst.clone
	if lives <= 0 {
		running = false
		hide
		broadcast "lose"
		return
	}
	invulnerable = true
	playerUpgrade = 0
	playerUpgradeUntil = 0.0
	setXYpos -48, -456
	setHeading Up
	setCostume "up"
	syncCamera()
	Camera.Follow Player
	wait 1
	invulnerable = false
}

onStart => {
	setXYpos -48, -456
	setHeading Up
	setCostume "up"
	syncCamera()
	Camera.Follow Player
	show
	for !gameReady {
		wait 0.02
	}
	for running {
		if playerUpgrade > 0 && timer >= playerUpgradeUntil {
			playerUpgrade = 0
		}
		if !gameReady {
			wait 0.02
			continue
		}
		beforeX = xpos
		beforeY = ypos
		if keyPressed(KeyLeft) || keyPressed(KeyA) {
			setHeading Left
			setCostume "left"
			changeXpos -2
		} else if keyPressed(KeyRight) || keyPressed(KeyD) {
			setHeading Right
			setCostume "right"
			changeXpos 2
		} else if keyPressed(KeyUp) || keyPressed(KeyW) {
			setHeading Up
			setCostume "up"
			changeYpos 2
		} else if keyPressed(KeyDown) || keyPressed(KeyS) {
			setHeading Down
			setCostume "down"
			changeYpos -2
		}
		if xpos < -144 || xpos > 144 || ypos < -456 || ypos > 456 || touching("Brick") || touching("Steel") || touching("River") || touching("Eagle") {
			setXYpos beforeX, beforeY
		}
		if ypos > 156 {
			stageIndex = stageTop
		} else if ypos > -156 {
			stageIndex = stageMiddle
		} else {
			stageIndex = stageBottom
		}
		syncCamera()
		wait 0.02
	}
}

onKey KeySpace, => {
	if playerUpgrade > 0 && timer >= playerUpgradeUntil {
		playerUpgrade = 0
	}
	if !gameReady || !running || timer-lastShot < 0.22-0.03*float64(playerUpgrade) {
		return
	}
	lastShot = timer
	if heading == 0 {
		PlayerShot.setXYpos xpos, ypos+13
	} else if heading == 90 {
		PlayerShot.setXYpos xpos+13, ypos
	} else if heading == 180 {
		PlayerShot.setXYpos xpos, ypos-13
	} else {
		PlayerShot.setXYpos xpos-13, ypos
	}
	PlayerShot.setHeading heading
	PlayerShot.clone
}

onTouchStart "Enemy", sprite => {
	takeHit()
}

onTouchStart "EnemyShot", sprite => {
	takeHit()
}

onMsg "resetPlayer", => {
	setXYpos -48, -456
	setHeading Up
	setCostume "up"
	syncCamera()
	Camera.Follow Player
	show
}
