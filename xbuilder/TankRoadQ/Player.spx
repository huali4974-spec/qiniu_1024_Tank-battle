var (
	lastShot = -1.0
	invulnerable = false
	beforeX = 0.0
	beforeY = 0.0
	moving = false
)

func takeHit() {
	if invulnerable || !running {
		return
	}
	lives--
	Burst.setXYpos xpos, ypos
	Burst.clone
	if lives <= 0 {
		running = false
		hide
		broadcast "lose"
		return
	}
	invulnerable = true
	setXYpos -48, -144
	setHeading Up
	setCostume "up"
	wait 1
	invulnerable = false
}

onStart => {
	setXYpos -48, -144
	setHeading Up
	setCostume "up"
	show
	for running {
		beforeX = xpos
		beforeY = ypos
		moving = false
		if keyPressed(KeyLeft) || keyPressed(KeyA) {
			setHeading Left
			setCostume "left"
			changeXpos -24
			moving = true
		} else if keyPressed(KeyRight) || keyPressed(KeyD) {
			setHeading Right
			setCostume "right"
			changeXpos 24
			moving = true
		} else if keyPressed(KeyUp) || keyPressed(KeyW) {
			setHeading Up
			setCostume "up"
			changeYpos 24
			moving = true
		} else if keyPressed(KeyDown) || keyPressed(KeyS) {
			setHeading Down
			setCostume "down"
			changeYpos -24
			moving = true
		}
		if moving && (xpos < -144 || xpos > 144 || ypos < -144 || ypos > 144 || touching("Brick") || touching("Steel") || touching("Eagle")) {
			setXYpos beforeX, beforeY
		}
		if moving {
			wait 0.22
		} else {
			wait 0.02
		}
	}
}

onKey KeySpace, => {
	if !running || timer-lastShot < 0.22 {
		return
	}
	lastShot = timer
	if heading == 0 {
		PlayerShot.setXYpos xpos-3, ypos+13
	} else if heading == 90 {
		PlayerShot.setXYpos xpos+13, ypos+3
	} else if heading == 180 {
		PlayerShot.setXYpos xpos-3, ypos-13
	} else {
		PlayerShot.setXYpos xpos-13, ypos+3
	}
	PlayerShot.setHeading heading
	PlayerShot.clone
}

onTouchStart "Enemy", sprite => {
	takeHit()
}

onTouchStart "EnemyShot", sprite => {
	takeHit()
}
