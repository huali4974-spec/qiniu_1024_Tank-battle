onMsg "loadStage", => {
  hide
  loadSelected(stageTop, 312, 0)
  loadSelected(stageMiddle, 0, 1)
  loadSelected(stageBottom, -312, 2)
}

onCloned data => {
  show
}

onMsg "clearBaseWall", => {
  if xpos >= -24 && xpos <= 24 && ypos >= -456 && ypos <= -432 {
    deleteThisClone
  }
}

onMsg "restoreBaseWall", => {
  if visible {
    return
  }
  setCostume "8"
  setXYpos -24, -432
  clone
  setCostume "c"
  setXYpos 0, -432
  clone
  setCostume "4"
  setXYpos 24, -432
  clone
  setCostume "a"
  setXYpos -24, -456
  clone
  setCostume "5"
  setXYpos 24, -456
  clone
}
