onCloned data => {
  show
}

onTouchStart "PlayerShot", sprite => {
  if !sprite.visible() {
    return
  }
  sprite.hide()
  sprite.destroy()
  destroy
}

onTouchStart "EnemyShot", sprite => {
  if !sprite.visible() {
    return
  }
  sprite.hide()
  sprite.destroy()
  destroy
}
