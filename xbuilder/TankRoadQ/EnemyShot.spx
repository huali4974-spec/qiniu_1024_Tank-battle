var (
	consumed = false
	flightTicks = 0
)

onStart => {
	hide
}

onCloned data => {
	consumed = false
	flightTicks = 0
	show
	for running {
		step 4
		flightTicks++
		if touching("Steel") {
			consumed = true
			destroy
		}
		if xpos < -156 || xpos > 156 || ypos < -468 || ypos > 468 || flightTicks >= 75 {
			destroy
		}
		wait 0.02
	}
	destroy
}

onTouchStart "Player", sprite => {
	if consumed {
		return
	}
	consumed = true
	destroy
}

onTouchStart "Eagle", sprite => {
	if consumed {
		return
	}
	consumed = true
	destroy
}

onTouchStart "Brick", sprite => {
	if consumed {
		return
	}
	consumed = true
	sprite.destroy
	destroy
}

onTouchStart "Steel", sprite => {
	if consumed {
		return
	}
	consumed = true
	destroy
}
