onStart => {
	hide
}

onCloned data => {
	show
	for running {
		step 4
		if xpos < -156 || xpos > 156 || ypos < -156 || ypos > 156 {
			destroy
		}
		wait 0.02
	}
	destroy
}

onTouchStart "Player", sprite => {
	destroy
}

onTouchStart "Eagle", sprite => {
	destroy
}

onTouchStart "Brick", sprite => {
	destroy
}

onTouchStart "Steel", sprite => {
	destroy
}
