var choice = 0

onStart => {
  hide
  setCostume "f"
  choice = rand(0, 3)
  if choice == 0 {
    setXYpos -96, 96
  } else if choice == 1 {
    setXYpos -48, 96
  } else if choice == 2 {
    setXYpos 48, 96
  } else if choice == 3 {
    setXYpos 96, 96
  }
  clone
  choice = rand(0, 2)
  if choice == 0 {
    setXYpos -48, 24
  } else if choice == 1 {
    setXYpos 0, 24
  } else if choice == 2 {
    setXYpos 48, 24
  }
  clone
  choice = rand(0, 3)
  if choice == 0 {
    setXYpos -96, -72
  } else if choice == 1 {
    setXYpos -48, -72
  } else if choice == 2 {
    setXYpos 48, -72
  } else if choice == 3 {
    setXYpos 96, -72
  }
  clone
}

onCloned data => {
  show
}
