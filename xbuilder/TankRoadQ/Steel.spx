    } else if choice == 8 {
      setXYpos -96, -24
    } else if choice == 9 {
      setXYpos -72, -24
    }
    setCostume "f"
    clone
    choice = int(rand(0, 9))
    if choice == 0 {
      setXYpos 48, -24
    } else if choice == 1 {
      setXYpos 120, -24
    } else if choice == 2 {
      setXYpos -48, -48
    } else if choice == 3 {
      setXYpos 48, -48
    } else if choice == 4 {
      setXYpos -96, -72
    } else if choice == 5 {
      setXYpos -72, -72
    } else if choice == 6 {
      setXYpos -120, -96
    } else if choice == 7 {
      setXYpos -72, -96
    } else if choice == 8 {
      setXYpos 72, -96
    } else if choice == 9 {
      setXYpos 96, -96
    }
    setCostume "f"
    clone
  } else if stageIndex == 35 {
    setCostume "f"
    setXYpos -48, 48
    clone
    setCostume "f"
    setXYpos 0, 48
    clone
    choice = int(rand(0, 4))
    if choice == 0 {
      setXYpos -120, 96
    } else if choice == 1 {
      setXYpos -96, 96
    } else if choice == 2 {
      setXYpos 48, 96
    } else if choice == 3 {
      setXYpos 72, 96
    } else if choice == 4 {
      setXYpos 120, 96
    }
    setCostume "f"
    clone
    choice = int(rand(0, 5))
    if choice == 0 {
      setXYpos -72, -96
    } else if choice == 1 {
      setXYpos -48, -96
    } else if choice == 2 {
      setXYpos -24, -96
    } else if choice == 3 {
      setXYpos 0, -96
    } else if choice == 4 {
      setXYpos 24, -96
    } else if choice == 5 {
      setXYpos 96, -96
    }
    setCostume "f"
    clone
  }
}

onCloned data => {
  show
}
