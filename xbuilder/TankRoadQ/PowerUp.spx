onStart => {
	hide
}

onCloned data => {
	show
}

onTouchStart "Player", sprite => {
	if !running || !gameReady || !visible {
		return
	}
	hide
	play "Pickup"
	score += 500
	if costumeName == "tank" {
		lives++
	} else if costumeName == "star" {
		if playerUpgrade < 3 {
			playerUpgrade++
		}
		playerUpgradeUntil = timer + 60
	} else if costumeName == "grenade" {
		broadcast "grenade"
	} else if costumeName == "timer" {
		enemyFreezeUntil = timer + 60
	} else if costumeName == "helmet" {
		playerShieldUntil = timer + 60
	} else if costumeName == "shovel" {
		if Player.xpos > -45 && Player.xpos < 45 && Player.ypos >= -466 && Player.ypos <= -420 {
			Player.setXYpos -48, -456
		}
		baseFortified = true
		baseFortifiedUntil = timer + 60
		broadcastAndWait "clearBaseWall"
		broadcastAndWait "buildBaseWall"
	}
	destroy
}

onMsg "clearPowerUp", => {
	deleteThisClone
}
