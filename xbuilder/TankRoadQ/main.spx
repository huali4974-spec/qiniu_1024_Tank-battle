var (
	score = 0
	lives = 3
	running = true
	spawned = 0
	defeated = 0
	activeEnemies = 0
	stageIndex = 1
	gameReady = false
)

onStart => {
	score = 0
	lives = 3
	running = true
	spawned = 0
	defeated = 0
	activeEnemies = 0
	gameReady = false
	stageIndex = int(rand(1, 35))
	broadcastAndWait "loadStage"
	wait 0.02
	gameReady = true
}
