onMsg "roundCleared", => {
	if !running || !gameReady || defeated < 30 {
		return
	}
	gameReady = false
	roundNumber++
	spawned = 0
	defeated = 0
	activeEnemies = 0
	broadcastAndWait "resetPlayer"
	wait 1
	gameReady = true
}
